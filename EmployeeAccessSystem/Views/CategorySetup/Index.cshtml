@model List<EmployeeAccessSystem.Models.CategorySetup>

@{
    ViewData["Title"] = "Category Setup";

    int selectedCategoryId = ViewBag.SelectedCategoryId;

    string successMessage = ViewBag.SuccessMessage;

    var categories =
        ViewBag.Categories as IEnumerable<EmployeeAccessSystem.Models.CategorySetup>;
}

<section class="content pt-2 pb-0">

    <div class="container-fluid px-2">

        <input type="hidden" id="successMessage" value="@successMessage" />
        <input type="hidden" id="tempSuccessMessage" value="@TempData["Success"]" />
        <input type="hidden" id="tempErrorMessage" value="@TempData["Error"]" />
        <input type="hidden" id="selectedCategoryId" value="@selectedCategoryId" />

        <div class="row mb-2 mx-0 align-items-center">

            <div class="col-sm-6 px-0">

                <h3 class="mb-0">
                    Category Setup
                </h3>

            </div>

            <div class="col-sm-6 text-right px-0">

                <button type="button"
                        id="btnAddSetupConfiguration"
                        class="btn btn-primary btn-sm">

                    <i class="fas fa-plus mr-1"></i>
                    Add

                </button>

            </div>

        </div>

        <div class="card card-outline card-primary mb-0 shadow-none">

            <div class="card-header bg-white py-2 px-2">

                <div class="row mx-0">

                    <div class="col-md-4 px-0">

                        <label class="font-weight-bold mb-1">
                            Select
                        </label>

                        <select id="showCategoryId"
                                class="form-control form-control-sm">

                            <option value="">
                                Select
                            </option>

                            @if (categories != null)
                            {
                                foreach (var category in categories)
                                {
                                    if (selectedCategoryId == category.CategoryId)
                                    {
                                        <option value="@category.CategoryId" selected>
                                            @category.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@category.CategoryId">
                                            @category.Name
                                        </option>
                                    }
                                }
                            }

                        </select>

                    </div>

                </div>

            </div>

            <div id="setupTableContainer"></div>

        </div>

    </div>

</section>

<div class="modal fade"
     id="setupConfigurationModal"
     tabindex="-1"
     role="dialog"
     data-backdrop="static"
     data-keyboard="false">

    <div class="modal-dialog modal-xl"
         role="document">

        <div class="modal-content rounded-0"
             id="setupConfigurationModalContent">
        </div>

    </div>

</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 400px;">
        <div class="modal-content rounded-0 shadow border-0" style="padding: 24px;">
            <div class="modal-body text-center p-0">
                
                <!-- Red Circle with Warning Icon -->
                <div class="mb-3 d-flex justify-content-center">
                    <span class="bg-danger rounded-circle d-inline-flex align-items-center justify-content-center"
                          style="width: 70px; height: 70px;">
                        <i class="fas fa-exclamation text-white fa-2x"></i>
                    </span>
                </div>

                <!-- Title -->
                <h4 class="font-weight-bold mb-2 text-dark" style="font-size: 22px;">Are you sure?</h4>

                <!-- Text -->
                <p class="text-secondary mb-4" style="font-size: 15px;">
                    Do you want to delete this record? <strong class="text-dark" id="deleteRecordName"></strong>
                </p>

                <!-- Actions Form -->
                <form id="deleteForm" method="post" action="/CategorySetup/Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="categoryId" id="deleteCategoryId" />
                    <input type="hidden" name="rootIndex" id="deleteRootIndex" />
                    <input type="hidden" name="nodeId" id="deleteNodeId" />
                    
                    <div class="d-flex justify-content-center">
                        <button type="button" class="btn btn-secondary mr-2 px-4" data-dismiss="modal" style="background-color: #6c757d; border-color: #6c757d; font-size: 14px; font-weight: 500;">Cancel</button>
                        <button type="submit" class="btn btn-danger px-4" style="background-color: #dc3545; border-color: #dc3545; font-size: 14px; font-weight: 500;">Confirm</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="~/js/categorysetup/index.js" asp-append-version="true"></script>

}